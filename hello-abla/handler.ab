import "micro.ab"

// This is the complete application. The adapter owns WebAssembly memory and
// wire encoding; handlers use normal typed Abla values.
fun handle(request: MicroRequest): MicroResponse {
    if (request.method != "GET") {
        microTextResponse(405, "method not allowed\n")
    } else if (request.path != "/") {
        microTextResponse(404, "not found\n")
    } else {
        // The literal is validated and encoded while this function is built;
        // an invocation only returns the frozen JSON text.
        microJsonResponse(200, #$jsons {
            "message": "hello from Abla"
        })
    }
}
